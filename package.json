{
  "name": "basepinball",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:physics": "vitest run tests/physics/perf.test.ts",
    "bench:rapier": "RAPIER_BENCH=1 vitest run tests/bench --reporter=verbose --silent=false",
    "layout:svg": "tsx tools/export-layout.ts",
    "simbot": "tsx tools/simbot.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.1",
    "three": "^0.186.1",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@eslint/js": "^10.0.1",
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^20.19.43",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
